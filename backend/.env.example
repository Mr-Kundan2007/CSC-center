# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Supabase Credentials (SERVER-SIDE ONLY - NEVER EXPOSE TO FRONTEND)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Authentication Secrets
JWT_SECRET=your_super_secret_jwt_key

# Payment Gateway Credentials (SERVER-SIDE ONLY)
PAYMENT_PROVIDER_KEY_ID=rzp_test_your_key_id
PAYMENT_PROVIDER_KEY_SECRET=your_payment_secret
PAYMENT_WEBHOOK_SECRET=your_webhook_secret

# Email Service Configuration (Nodemailer / SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM="CSC Center" <support@csccenter.in>
